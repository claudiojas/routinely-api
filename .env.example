# .env.example (RODA EM DESENVOLVIMENTO)

# --- Configuração do Banco de Dados PostgreSQL ---
# Usado para rodar comandos Prisma (migrate, studio, etc.) da sua máquina LOCAL
DATABASE_URL="postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5482/POSTGRES_DB"
DIRECT_URL="postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5482/POSTGRES_DB"

# Variáveis usadas pelo docker-compose.yml para criar o container do banco
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Segredos da Aplicação ---
# Chave secreta para assinar os tokens JWT (gere uma chave segura aqui)
JWT_SECRET=

# --- Credenciais Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI_FRONTEND=http://localhost:8080